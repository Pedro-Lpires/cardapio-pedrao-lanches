# Somente nomes de variáveis. Configure os valores privados no servidor.
# A recuperação permanece desativada até a migração de login e regras.
RECUPERACAO_ACESSO_ATIVA=false
REGRAS_FIRESTORE_PROTEGIDAS=false
# Compatibilidade de firebase-admin/jwks-rsa com jose ESM na Vercel (Node 24).
NODE_OPTIONS=--experimental-require-module
SITE_PUBLICO_URL=https://cardapio-pedrao-lanches.vercel.app/
FIREBASE_PROJECT_ID=pedrao-lanches
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Chave aleatória de 32 bytes, codificada em base64; nunca usar no frontend.
RECUPERACAO_CHAVE=
# UIDs do proprietário no Firebase Authentication, separados por vírgula.
ADMIN_AUTH_UIDS=
